# Copy to .env and fill in. Every variable here is validated in src/config/env.ts.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Matches docker-compose.yml
DATABASE_URL=postgresql://klyro:klyro_dev@localhost:5432/klyro
DB_POOL_MAX=10
REDIS_URL=redis://localhost:6379

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Allowed browser origin for CORS (comma-separate several)
FRONTEND_URL=http://localhost:5173

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="KlyroStream <no-reply@klyro.local>"
PASSWORD_RESET_URL=http://localhost:5173/reset-password
