# Copy to .env and fill in. Every variable here is validated in src/config/env.ts.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Matches docker-compose.yml
DATABASE_URL=postgresql://klyro:klyro_dev@localhost:5432/klyro
DB_POOL_MAX=10
REDIS_URL=redis://localhost:6379

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Allowed browser origin for CORS (comma-separate several)
FRONTEND_URL=http://localhost:5173,http://localhost:4100

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="KlyroStream <no-reply@klyro.local>"
PASSWORD_RESET_URL=http://localhost:5173/reset-password
INVITE_URL=http://localhost:5173/invite
VIDEO_URL=http://localhost:5173/videos

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/auth/callback

# RustFS (S3-compatible storage), matches docker-compose.yml
S3_ENDPOINT=http://localhost:9000
# Host the client uses in presigned URLs; differs from S3_ENDPOINT once the API runs in Docker
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=klyro
S3_SECRET_KEY=klyro_dev_storage
# Lifetime of the presigned segment URLs inside a streamed playlist
STREAM_URL_TTL_SECONDS=300

# Bull Board job dashboard at /admin/queues (basic auth). Leave both empty to turn it off.
# Generate a password with: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=

# Worker: video jobs per worker process. FFmpeg already uses every core, so keep it at 1.
WORKER_CONCURRENCY=1
# Worker: share of video jobs that fail on purpose (0 to 1) to test retries. Must be 0 in production.
FAIL_RATE=0
