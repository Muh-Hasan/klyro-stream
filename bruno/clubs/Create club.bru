meta {
  name: Create club
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/clubs
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Chess Club"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("clubId", res.getBody().club.id);
}
