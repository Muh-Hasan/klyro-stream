meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "test@example.com",
    "password": "password123"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("accessToken", res.getBody().accessToken);
    // Keep the old refresh token so "Refresh (replay)" can send it again.
    const setCookie = [].concat(res.getHeader("set-cookie") || []).find((c) => c.startsWith("rt="));
    if (setCookie) {
      bru.setVar("previousRefreshToken", bru.getVar("currentRefreshToken"));
      bru.setVar("currentRefreshToken", setCookie.split(";")[0].slice(3));
    }
  }
}
